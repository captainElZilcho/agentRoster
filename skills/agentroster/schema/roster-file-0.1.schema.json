{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/captainElZilcho/agentRoster/main/schema/roster-file-0.1.schema.json",
  "title": "AgentRoster roster file v0.1",
  "description": "One file holding every roster card of a run, with the run snapshot. This schema checks the envelope; each card is checked with the roster card schema.",
  "type": "object",
  "properties": {
    "roster_file": {
      "const": "0.1",
      "x-error": "must be the string \"0.1\""
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "roster_file",
    "snapshot",
    "cards"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "x-error": "must be a kebab-case id like \"fleet-scout\""
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run-[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$",
          "x-error": "must be a run id like \"run-2026-11-05-1\""
        },
        "taken_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "x-error": "must be a UTC time like \"2026-11-05T14:30:00Z\""
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "none",
              "None",
              "NONE"
            ],
            "x-error": "use null for an empty value, not the text \"none\""
          },
          "pattern": "^[^/\\\\]+$",
          "x-error": "must be a project name: non-empty text, not a path"
        },
        "standard": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$",
                "x-error": "must be a version like \"0.1\""
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "enum": [
            "standard",
            "quick",
            "thorough"
          ]
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^run-[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$",
              "x-error": "must be a run id like \"run-2026-11-05-1\""
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "taken_at",
        "project",
        "standard",
        "packs",
        "mode",
        "previous"
      ],
      "additionalProperties": false
    }
  }
}
