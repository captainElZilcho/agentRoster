{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/captainElZilcho/agentRoster/main/schema/answers-file-0.1.schema.json",
  "title": "AgentRoster answers file v0.1",
  "description": "agentroster.json at a project's root: answers the user gave to the skill's questions, applied on every later run.",
  "type": "object",
  "properties": {
    "agentroster": {
      "const": "0.1",
      "x-error": "must be the string \"0.1\""
    },
    "answers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/answer"
      }
    }
  },
  "required": [
    "agentroster",
    "answers"
  ],
  "additionalProperties": false,
  "$defs": {
    "answer": {
      "type": "object",
      "properties": {
        "card": {
          "$ref": "#/$defs/id"
        },
        "field": {
          "enum": [
            "type"
          ],
          "x-error": "must be \"type\" (the only field open to asking in 0.1)"
        },
        "value": {
          "$ref": "#/$defs/type"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-error": "must be a date like \"2026-11-18\""
        },
        "based_on": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "line": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "quote": {
              "type": "string"
            }
          },
          "required": [
            "file",
            "line",
            "quote"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "card",
        "field",
        "value",
        "date"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "x-error": "must be a kebab-case id like \"fleet-scout\""
    },
    "type": {
      "enum": [
        "orchestrator",
        "assistant",
        "researcher",
        "builder",
        "specialist",
        "reviewer",
        "gatekeeper",
        "operator",
        "monitor"
      ]
    }
  }
}
