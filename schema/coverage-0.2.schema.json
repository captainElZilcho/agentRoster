{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/captainElZilcho/agentRoster/main/schema/coverage-0.2.schema.json",
  "title": "AgentRoster coverage v0.2",
  "description": "The scan's own record of what it looked at and what it could not see: every candidate place, and every part of a definition left unknown.",
  "type": "object",
  "properties": {
    "coverage": {
      "const": "0.2",
      "x-error": "must be the string \"0.2\""
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "summary": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "read": {
          "type": "integer",
          "minimum": 0
        },
        "not_read": {
          "type": "integer",
          "minimum": 0
        },
        "not_understood": {
          "type": "integer",
          "minimum": 0
        },
        "cards": {
          "type": "integer",
          "minimum": 0
        },
        "no_agent": {
          "type": "integer",
          "minimum": 0
        },
        "needs_checking": {
          "type": "integer",
          "minimum": 0
        },
        "unknowns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "candidates",
        "read",
        "not_read",
        "not_understood",
        "cards",
        "no_agent",
        "needs_checking",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    }
  },
  "required": [
    "coverage",
    "snapshot",
    "summary",
    "candidates",
    "unknowns"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          "none",
          "None",
          "NONE"
        ],
        "x-error": "use null for an empty value, not the text \"none\""
      }
    },
    "textOrNull": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "not": {
        "enum": [
          "none",
          "None",
          "NONE"
        ],
        "x-error": "use null for an empty value, not the text \"none\""
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "x-error": "must be a kebab-case id like \"fleet-scout\""
    },
    "path": {
      "type": "string",
      "pattern": "^(?![/\\\\~])(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$",
      "x-error": "must be a repo-relative path with forward slashes"
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run-[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$",
          "x-error": "must be a run id like \"run-2026-11-05-1\""
        },
        "taken_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "x-error": "must be a UTC time like \"2026-11-05T14:30:00Z\""
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "none",
              "None",
              "NONE"
            ],
            "x-error": "use null for an empty value, not the text \"none\""
          },
          "pattern": "^[^/\\\\]+$",
          "x-error": "must be a project name: non-empty text, not a path"
        },
        "standard": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+$",
                "x-error": "must be a version like \"0.1\""
              }
            },
            "required": [
              "id",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "mode": {
          "enum": [
            "standard",
            "quick",
            "thorough"
          ]
        },
        "previous": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^run-[0-9]{4}-[0-9]{2}-[0-9]{2}-[1-9][0-9]*$",
              "x-error": "must be a run id like \"run-2026-11-05-1\""
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "taken_at",
        "project",
        "standard",
        "packs",
        "mode",
        "previous"
      ],
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "quote": {
          "$ref": "#/$defs/text"
        },
        "found_by": {
          "enum": [
            "script",
            "agent",
            "hand"
          ]
        }
      },
      "required": [
        "file",
        "line",
        "quote",
        "found_by"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "llm-import",
              "llm-call",
              "claude-agent-file",
              "skill-file",
              "mcp-config",
              "roster-card",
              "prompt-file",
              "other"
            ]
          }
        },
        "detail": {
          "$ref": "#/$defs/textOrNull"
        },
        "status": {
          "enum": [
            "read",
            "not-read",
            "not-understood"
          ]
        },
        "reason": {
          "$ref": "#/$defs/textOrNull"
        },
        "outcome": {
          "enum": [
            "cards",
            "no-agent",
            "pending"
          ]
        },
        "cards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "note": {
          "$ref": "#/$defs/textOrNull"
        },
        "found_by": {
          "enum": [
            "script",
            "agent"
          ]
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      },
      "required": [
        "file",
        "line",
        "signals",
        "detail",
        "status",
        "reason",
        "outcome",
        "cards",
        "note",
        "found_by",
        "validation"
      ],
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "properties": {
        "card": {
          "$ref": "#/$defs/id"
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z_]+(\\.([A-Za-z_]+|[0-9]+))*$",
          "x-error": "must be a field path like \"guardrails.forbidden\" or \"goals.0\""
        },
        "reason": {
          "enum": [
            "loaded-from-database",
            "loaded-from-url",
            "loaded-from-env",
            "outside-repo",
            "unparsable",
            "unsupported-framework",
            "other"
          ]
        },
        "detail": {
          "$ref": "#/$defs/textOrNull"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceItem"
          }
        }
      },
      "required": [
        "card",
        "field",
        "reason",
        "detail",
        "evidence"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "validated",
            "needs-checking"
          ]
        },
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "status",
        "rounds"
      ],
      "additionalProperties": false
    }
  }
}
